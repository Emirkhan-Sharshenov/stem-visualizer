# Gemini API key for the Visual Mentor endpoint (optional — falls back to built-in hints)
GEMINI_API_KEY=""

# Public URL of the app
APP_URL=""

# Supabase (accounts and cloud progress). Settings → API in your Supabase project.
# The anon key is public by design; data is protected by Row Level Security.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Card payments (Freemius → Products → Settings → Keys). Public values:
VITE_FREEMIUS_PRODUCT_ID=
VITE_FREEMIUS_PUBLIC_KEY=
VITE_FREEMIUS_PLAN_ID=
# Server only, never commit the real value:
FREEMIUS_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
